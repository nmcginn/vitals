# HELP vitals_build_info Always 1; the labels name the running build.
# TYPE vitals_build_info gauge
vitals_build_info{version="v1.0.0",commit="abc1234"} 1
# HELP vitals_host_info Always 1; the labels describe the host.
# TYPE vitals_host_info gauge
vitals_host_info{hostname="mini",os="darwin",os_version="26.1",kernel="25.1.0",arch="arm64"} 1
# HELP vitals_uptime_seconds Seconds since boot.
# TYPE vitals_uptime_seconds gauge
